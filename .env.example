# 家庭账房 · v0.7 Docker 配置 —— 复制为 .env(git-ignored)
# 懒人:直接跑 `bash deploy/docker-up.sh`,它会自动生成下面的随机密钥并起服务(无需手动复制本文件)。

# ── 数据库 ──
DB_NAME=finance
DB_USER=finance
DB_PASS=请改成强密码
MYSQL_ROOT_PASSWORD=请改成另一个强密码

# 数据库镜像。留空即用默认的 GHCR 副本(大陆直连);docker-up.sh 会自动探测并把实际用的那个写回 .env。
# 想强制走 Docker Hub 官方源(海外机器 / 已配好镜像加速):MYSQL_IMAGE=mysql:8.0
# MYSQL_IMAGE=ghcr.io/luodi-nate/financial-management-mysql:8.0

# ── 应用 ──
SERVER_PORT=20000
# 会话签名 key,改了会踢掉所有登录态;建议 32 字节随机:openssl rand -hex 32
REMEMBER_ME_KEY=请改成32字节随机串
TZ=Asia/Shanghai
# 种子账号(用户名 diwa / wangergou)首次登录的临时密码;首次登录后会强制改密。
# 留 demo1234 即可,想换就改这里(仅首装生效;已初始化的库不会被改)。
SEED_ADMIN_PASSWORD=demo1234
# 全新安装默认会清掉内置的演示数据,让你从「空态」开始(与 systemd 直装一致,会触发新手引导)。
# 想保留演示数据先看填充效果?设 FINANCE_KEEP_DEMO=1(仅对全新库生效,迁移/升级的库永不被动)。
# FINANCE_KEEP_DEMO=1

# ── 备份 sidecar ──
RETENTION_DAYS=56

# ── 富途 OpenD 网关(可选组件 · 只有你要用券商同步才需要)──
# 默认的 `docker compose up -d` 【不拉、不起、不占磁盘】。要用富途就启用一次:
#     bash deploy/docker-up.sh --with-futu        (推荐 · 会把选择记进本文件)
#     docker compose --profile futu up -d         (等价的原生命令)
#
# 账号和密码【不在这里配】—— 在页面上填(设置 → 数据源接入 → 富途),存本机数据库。
# v1.17 之前这里要写 FUTU_ACCOUNT / FUTU_PWD_MD5 明文,已经不需要了;
# 老配置留着也不报错,但建议删掉那两行、改到页面上填。
#
# 关于那个镜像:里面【没有富途的任何文件】,只有下载器 + 两个 shell 脚本 + 我们核对过的哈希清单。
# OpenD 本体由该容器首启时从富途官网下载,下完先比对 sha256(不一致就拒绝启动)。
# 富途官方【不公布】校验和,所以那些哈希是我们自己算的,钉在 deploy/futu-opend-releases.json
# (可以自己核对:sha256sum,或 curl -sI <下载地址> | grep -i etag)。
# 镜像 digest 与 `gh attestation verify` 的验证命令见 GitHub Release 页。
#
# FUTU_ENABLED=1              # docker-up.sh --with-futu 会自动写这行,之后每次都带上 profile
# FUTU_OPEND_IMAGE=...        # 逃生阀:不信我们构建的,换成你自己的镜像
# FUTU_ALLOW_UNVERIFIED=1     # 允许装我们还没核对过哈希的版本(默认 0 = 只装核对过的)
# FUTU_API_RSA=0              # 关掉 API 通道加密(默认 1 开着;关了同栈其它容器就能读你的持仓)
#
# 老路径(v1.16 及以前 · 自备镜像):deploy/futu-opend.compose.yml 仍然保留,配置照旧生效。

# 说明:LLM key / 短信 aksk / checkup 阈值 等运营参数不在这里配 ——
# 首次登录后走管理页(/admin/integrations 等),存数据库,实时生效。
