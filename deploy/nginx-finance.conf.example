# =========================================================
# nginx 反代片段 · 家庭账房 v0.1
#
# 注:用户上游(域名服务/CDN)已终结 TLS,本机 nginx 仅接 HTTP
#
# 安装:
#   sudo install -m 644 deploy/nginx-finance.conf.example \
#       /etc/nginx/sites-available/finance.conf
#   sudo ln -sf /etc/nginx/sites-available/finance.conf \
#       /etc/nginx/sites-enabled/finance.conf
#   sudo nginx -t && sudo systemctl reload nginx
# =========================================================

upstream finance_backend {
    server 127.0.0.1:__PORT__ fail_timeout=10s max_fails=3;
    keepalive 16;
}

server {
    listen 80;
    server_name __SERVER_NAME__;           # 由 nginx-setup.sh 替换为域名 / IP / "_"

    client_max_body_size 256k;             # 与 Spring multipart 对齐(logo 上限 200KB)
    access_log /var/log/nginx/finance.access.log;
    error_log  /var/log/nginx/finance.error.log warn;

    # 用户上传的 logo · 走 nginx 直读文件系统,绕过 Java(更快)
    location /uploads/ {
        alias /var/finance/uploads/;
        expires 7d;
        add_header Cache-Control "public";
        access_log off;
        try_files $uri =404;
    }

    # v0.15 · 富途 OpenD tar.gz 上传(几十 MB)· 仅此路径放开体积限额 + 关闭请求缓冲(边收边转,不落盘整包)
    # 其它路径仍受上面 256k 全局限额保护(logo)。改不了反代的,用向导「服务器路径导入」绕开。
    location = /admin/broker/opend/upload {
        client_max_body_size 500m;
        proxy_request_buffering off;
        proxy_pass         http://finance_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto http;
        proxy_set_header   Connection        "";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # 所有其它请求(含 /css/ /js/ /img/ /vendor/ /favicon.ico /dashboard 等)
    # 统一走后端反代。Spring 已经在 link 上加 ?v=${buildVersion} 做 cache-busting,
    # 不需要再在 nginx 单独给静态资源加 expires。
    # 超级 Agent 的流式回答(SSE)。
    #
    # 2026-09-22 在测试环境实测出来的:从浏览器问一个稍复杂的问题
    #(「资产多少 / 分布如何 / 有什么建议」),150 秒一个字都没回来,浏览器一个 504;
    # 而直连应用是好的 —— 问题全在反代这一层:
    #   ① nginx 默认【缓冲】上游响应,SSE 于是不再是流式(用户盯着空白等);
    #   ② `proxy_read_timeout` 默认 60s,而一次带工具调用的问答经常更久。
    #
    # 应用已经自己做了两道防护(响应头 `X-Accel-Buffering: no` + 每 15s 一个 SSE 心跳),
    # 所以【即使你不加这个 location 也能用】。这里显式写出来是为了说清意图,
    # 也给那些把 buffering 强行打开、或者用别的反代的人一个照抄的模板。
    location ~ ^/ask/[0-9]+/stream$ {
        proxy_pass         http://finance_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto http;
        proxy_set_header   Connection        "";
        proxy_buffering    off;      # SSE 必须关缓冲,否则不是流式
        proxy_cache        off;
        proxy_read_timeout 300s;     # 一次带工具调用的问答可以很久
        proxy_send_timeout 300s;
    }

    # 历史遗留:不要单独给 /css/ 拆出 location 块 — 那样会少几条 proxy_set_header,
    # 触发 Spring forward-headers-strategy=framework 的边界 bug,导致 CSS 加载失败。
    location / {
        proxy_pass         http://finance_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto http;     # 上游已脱 TLS,这里就是 http
        proxy_set_header   Connection        "";
        proxy_read_timeout 90s;   # AI 诊断/洞察真调 LLM 可超 30s(随机模型+重试链)
        proxy_send_timeout 90s;
    }

    # 限制后台 admin 只允许内网 IP(可选,按需打开)
    # location /admin/ {
    #     allow 192.168.0.0/16;
    #     allow 10.0.0.0/8;
    #     deny all;
    #     proxy_pass http://finance_backend;
    # }
}
