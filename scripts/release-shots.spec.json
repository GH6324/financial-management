{
  "_comment": "v1.19.0 · 超级 Agent。PC 用 selector 裁掉导航与留白只留对话卡;手机整屏不裁。",
  "pc": [
    {
      "path": "/ask?conv=26",
      "name": "ask-conv",
      "wait": 2000,
      "waitFor": ".ask-chart canvas",
      "selector": ".ask-shell"
    },
    {
      "path": "/ask?conv=26",
      "name": "ask-think",
      "wait": 2000,
      "waitFor": ".ask-acts",
      "eval": "document.querySelectorAll('details.ask-acts').forEach(d=>d.open=true);const t=document.querySelector('.ask-turn'); if(t) t.id='shot-target';",
      "selector": "#shot-target"
    },
    {
      "path": "/ask",
      "name": "ask-empty",
      "wait": 900,
      "waitFor": ".ask-empty",
      "selector": ".ask-shell"
    },
    {
      "path": "/admin/ai-access",
      "name": "ask-admin",
      "wait": 900,
      "waitFor": ".paper-card",
      "eval": "const c=document.querySelectorAll('.paper-card'); if(c.length) c[c.length-1].id='shot-target';const p=[...document.querySelectorAll('.paper-card')].find(x=>x.innerText.includes('跑 在 哪 里'));if(p) p.id='shot-target';",
      "selector": "#shot-target"
    }
  ],
  "mobile": [
    {
      "path": "/ask?conv=26",
      "name": "ask-conv",
      "wait": 2000,
      "full": false,
      "waitFor": ".ask-chart canvas"
    },
    {
      "path": "/ask",
      "name": "ask-empty",
      "wait": 900,
      "full": false,
      "waitFor": ".ask-empty"
    }
  ]
}